{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Kernel (Launcher)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/launcher",
            "env": {
                "CP_DATABASE_URL": "postgres://postgres:postgres@localhost:5432/cp_db?sslmode=disable",
                "PORT": "8080",
                "AEGIS_JWT_SECRET": "dev-only-aegis-jwt-secret-change-me-0001",
                "PGBOUNCER_NODES": "localhost:6432,localhost:6433"
            }
        },
        {
            "name": "Debug: Module Auth (Standalone HTTP)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/modules/auth/cmd",
            "env": {
                "STANDALONE_PORT": "8081",
                "AEGIS_JWT_SECRET": "dev-only-aegis-jwt-secret-change-me-0001"
            }
        },
        {
            "name": "Debug: Module Parties (Standalone HTTP)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/modules/parties/cmd",
            "env": {
                "STANDALONE_PORT": "8082"
            }
        },
        {
            "name": "Debug: Module Audit (Standalone HTTP)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/modules/audit/cmd",
            "env": {
                "STANDALONE_PORT": "8083"
            }
        }
    ]
}
